# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret — server-only. SUPABASE_SERVICE_ROLE_KEY is used by scripts/import
# and by lib/supabase/serviceClient.ts (order writes in app/api/**).
# SQUAD_SECRET_KEY is used by lib/squad.ts (checkout + webhook). Sandbox
# keys are prefixed "sandbox_sk_..." — that prefix is what picks the
# sandbox vs live API base URL, see lib/squad.ts.
SUPABASE_SERVICE_ROLE_KEY=
SQUAD_SECRET_KEY=
