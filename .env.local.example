# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret — server-only. SUPABASE_SERVICE_ROLE_KEY is used by scripts/import
# and by lib/supabase/serviceClient.ts (order writes in app/api/**).
# PAYSTACK_SECRET_KEY is used by lib/paystack.ts (checkout + webhook).
SUPABASE_SERVICE_ROLE_KEY=
PAYSTACK_SECRET_KEY=
