# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret — server-only. SUPABASE_SERVICE_ROLE_KEY is used by scripts/import
# and by lib/supabase/serviceClient.ts (order writes in app/api/**).
# SQUAD_SECRET_KEY is used by lib/squad.ts (checkout + webhook). Sandbox
# keys are prefixed "sandbox_sk_..." — that prefix is what picks the
# sandbox vs live API base URL, see lib/squad.ts.
SUPABASE_SERVICE_ROLE_KEY=
SQUAD_SECRET_KEY=

# Canonical site origin used for metadata, OG images, sitemap and email links.
# Optional on Vercel (falls back to the production domain); set it once a
# custom domain is attached, e.g. https://otecng.com
NEXT_PUBLIC_SITE_URL=

# Receipt emails (lib/email/send.ts) via Resend. Without RESEND_API_KEY,
# receipts are skipped and logged. EMAIL_FROM's domain must be verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="otecng <orders@your-domain.com>"
EMAIL_REPLY_TO=
# Optional: gets a BCC of every receipt as a new-order alert.
STORE_ORDER_EMAIL=
